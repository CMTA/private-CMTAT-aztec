# Copy to .env and fill in. `.env` is gitignored; this file is not, so keep real
# credentials out of it.
#
# Nothing here is needed for the Noir suite: `yarn test:nr` runs against the TXE and
# reads no environment. The local end-to-end run needs only L1_MNEMONIC. The rest is
# for the testnet scripts.

# ---- Network endpoints -------------------------------------------------------------
# L1 RPC. Used by the scripts that bridge Fee Juice, and by `aztec` commands run beside
# them. For a local network this is anvil: http://localhost:8545
L1_URL=https://ethereum-sepolia-rpc.publicnode.com

# Aztec node. `src/utils/setup_pxe.ts` defaults to http://localhost:8080 when unset, so
# set this only for testnet.
NODE_URL="https://aztec-alpha-testnet-fullnode.zkv.xyz" # testnet

# ---- Deployed contract -------------------------------------------------------------
# An already-deployed token, so `yarn interaction` can mint, transfer and read against it
# instead of deploying a new one. Read only by scripts/interaction.ts, which errors if it
# is unset. The link below is the contract *class* — the hash of the compiled artifact,
# which says which code is deployed, where the address says which instance.
CMTA_TOKEN_CONTRACT_ADDRESS="0x1ec40412f9f5f4fa6060bdb7e24cef906dd2f5c93561acec43f61d3d9a2e32e5" # testnet
# contract class: https://aztecscan.xyz/contracts/classes/0x0f8d035459eb0e414f51bef34ff311db5b7b4b961c608e4b16b3f9b857c8926a/versions/1

# ---- Accounts ----------------------------------------------------------------------
# Schnorr accounts rebuilt by src/utils/create_account_from_env.ts, which deploys each one
# only if it is not on chain yet. The secret is the account's master secret and the signing
# key is derived from it, which is why a pair is enough; the salt enters the address
# derivation, so the same secret with a different salt is a different account. Storing them
# is what makes the testnet scripts talk to the same accounts across runs.
#
# WARNING: these are real Sepolia testnet secrets in a committed file. Replace them with
# your own, and never put a secret that guards anything of value in this file.
SECRET1="0x207f48d6117f574c3e941698e5c1947032e586773a849ea68ab60a6676f86bf4"
SALT1="0x071186935d018a0f787f7a3424bfda02b09a13d54a0d41bfa69aa9bbd980d509"
# address this pair used to resolve to: 0x143dc5a6984bfb36419f5772f8c71b3f883267f0b023775b963bef12bc92fc9e
# STALE: key derivation and address computation both changed at Aztec v3, so a pair no
# longer resolves to the address it did on 0.87. Recompute rather than trusting these.
SECRET2="0x189e3c8a686daec52cbde48c49ebb909fdf9f922239b8188ef829e10ab07d6ce"
SALT2="0x026ed1c68bf2217166eb3478288e2daafab4af6744436feff223f83c44e02d6c"
# address this pair used to resolve to: 0x02b8ea9a31850a90a3c70f97398b30836cc9eca2c9561c23954abcfeadc7cc62 (stale, as above)

# ---- L1 chain ----------------------------------------------------------------------
# Sepolia's chain ID, the L1 this testnet settles to. No TypeScript in this repository
# reads it: it is here for the `aztec` and `aztec-wallet` CLIs, which accept it as
# --l1-chain-id and take $L1_CHAIN_ID as the environment form.
L1_CHAIN_ID="11155111" # Sepolia

# ---- L1 signer ---------------------------------------------------------------------
# Mnemonic used to sign L1 transactions: the Fee Juice portal deposit in the e2e suite and
# in `yarn fees`. Read by src/utils/l1_dev_account.ts, which throws when it is unset rather
# than falling back, so that no credential is ever a literal in the source. The value below
# is Foundry/anvil's published default, which `aztec start --local-network` also uses: fine
# for chain 31337, never for a network where the accounts are real.
L1_MNEMONIC="test test test test test test test test test test test junk"
